        "regex": "(\\d+\\.\\d+\\.\\d+)"
      },
      "install": {
        "command": {
          "linux": "curl -fsSL https://opencode.ai/install | bash",
          "darwin": "curl -fsSL https://opencode.ai/install | bash"
        },
        "npmPackage": "opencode-ai",
        "docsUrl": "https://opencode.ai/docs"
      }
    }
  },
  {
    "id": "codex",
