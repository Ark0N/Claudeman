  {
    "id": "pi",
    "label": "Pi",
    "stock": true,
    "discovery": {
      "binaries": ["pi"],
      "searchDirs": ["~/.local/bin", "/usr/local/bin", "~/.bun/bin", "~/.npm-global/bin", "~/bin"],
      "version": {
        "arg": "--version",
        "regex": "(?:^|\\s)(\\d+\\.\\d+\\.\\d+)",
        "requireVersionMatch": true
      },
      "install": {
        "command": {
          "linux": "npm install -g --ignore-scripts @earendil-works/pi-coding-agent",
