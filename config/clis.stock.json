      },
      "install": {
        "command": {
          "linux": "npm install -g @openai/codex",
          "darwin": "npm install -g @openai/codex"
        },
        "npmPackage": "@openai/codex",
        "docsUrl": "https://developers.openai.com/codex/cli"
      }
    }
  },
  {
    "id": "gemini",
    "label": "Gemini",
